# PostgreSQL connection string from your database provider
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_SSL=true

# Long random value used to sign login cookies
SESSION_SECRET=replace-with-a-long-random-secret

# Google service-account JSON as ONE LINE. Do not commit the real value.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Google Drive folder ID. Share this folder with the service-account email as Editor.
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# Render sets PORT automatically; local default is 3000.
PORT=3000
NODE_ENV=production
